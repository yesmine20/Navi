# From Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional — leave unset for newer projects (asymmetric signing keys; app/auth.py verifies
# against the project's public JWKS instead automatically). Only set this for older projects
# still on the legacy shared secret: Project Settings → API → JWT Settings → JWT Secret.
SUPABASE_JWT_SECRET=

# At least one of the two below is needed for /chat and /profile/refresh's proposal step —
# without either, the app still boots but those routes return 503 (docs/ARCHITECTURE.md §6:
# no provider configured = no response generated, not a crash). Both can be set at once; the
# gateway tries each in turn (§1's "multi-provider, circuit breaker").
ANTHROPIC_API_KEY=
# From console.mistral.ai → API Keys.
MISTRAL_API_KEY=
